[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/audio_options.gd" id="1"]

[node name="AudioOptions" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1")

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.74, 0.69, 1)
theme_override_font_sizes/font_size = 13
text = "Калибровка: 50% — прежний уровень. Выше — усиление. 0% — без звука."

[node name="Scroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Reset" type="Button" parent="."]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 0
text = "Исходный микс · 50%"

[node name="Error" type="Label" parent="."]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.69, 0.46, 1)
theme_override_font_sizes/font_size = 13
autowrap_mode = 2

[node name="Preview" type="AudioStreamPlayer" parent="."]
bus = &"Interface"

[node name="PreviewTimer" type="Timer" parent="."]
wait_time = 3.0
one_shot = true
